# Public-facing bearer token required by POST /v1/translate.
# Generate a long random secret and set the SAME value as
# VAML_TRANSLATOR_API_TOKEN in Agent-language-Translate.
VAML_TRANSLATOR_ACCESS_TOKEN=

# Private runtime endpoint that performs the real Human <-> VAML translation.
# This must stay server-side and must not point back to api.vaml.vynalthai.com/v1/translate.
VAML_RUNTIME_API_URL=

# Optional bearer token for the private runtime.
VAML_RUNTIME_API_TOKEN=
