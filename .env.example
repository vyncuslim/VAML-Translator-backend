# Public-facing bearer token required by POST /v1/translate.
# Generate a long random secret and set the SAME value as
# VAML_TRANSLATOR_API_TOKEN in Agent-language-Translate.
VAML_TRANSLATOR_ACCESS_TOKEN=

# Private runtime endpoint that performs the real Human <-> VAML translation.
# This must stay server-side and must not point back to api.vaml.vynalthai.com/v1/translate.
VAML_RUNTIME_API_URL=

# Optional bearer token for the private translation runtime.
VAML_RUNTIME_API_TOKEN=

# Public-facing bearer token required by POST /v1/chat.
# Keep this separate from the translator token. Set the SAME value as
# AGENT_CHAT_API_TOKEN in Agent-language-Translate.
VAML_CHAT_ACCESS_TOKEN=

# Private AI Agent/VAML chat runtime. This must stay server-side and must not
# point back to api.vaml.vynalthai.com/v1/chat.
VAML_CHAT_RUNTIME_API_URL=

# Optional bearer token for the private chat runtime.
VAML_CHAT_RUNTIME_API_TOKEN=
